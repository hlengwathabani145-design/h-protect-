name: Build H Protect APK
on:
  push:
    branches: [ main ]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: Setup Java 21
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '21'

      - name: Setup Node 20
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3

      - name: Create H Protect App
        run: |
          rm -rf www android
          mkdir www
          cat > www/index.html << 'HTML'
          <html><head><meta name="viewport" content="width=device-width"><style>body{font-family:sans-serif;text-align:center;padding:30px;background:#0f172a;color:white}h1{color:#22c55e}.card{background:#1e293b;padding:20px;border-radius:12px;margin-top:20px}</style></head><body><h1>🛡️ H Protect</h1><p>Lightweight Play Protect Clone</p><div class="card"><p id="s">Scanning...</p></div><script>setTimeout(()=>{document.getElementById('s').innerHTML='✅ No threats found<br><br>Device is secure'},2000)</script></body></html>
          HTML
          echo '{"name":"h-protect","appId":"com.hprotect.app","webDir":"www"}' > capacitor.config.json
          npm install @capacitor/core@latest @capacitor/cli@latest @capacitor/android@latest
          npx cap add android
          npx cap copy

      - name: Build Debug APK
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug --stacktrace

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: H-Protect-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
